# ──────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — Backend AdonisJS (Servicios Digitales UTO)
# Copiar como '.env' en esta misma carpeta para desarrollo local.
# En producción estas variables se inyectan directamente en docker-compose.yml
# desde el .env raíz del proyecto — NO es necesario crear un .env aquí.
# ──────────────────────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────────────────────
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# Clave maestra de cifrado de AdonisJS.
# Generar UNA SOLA VEZ con: node ace generate:key
# ADVERTENCIA: cambiarla en producción invalida todos los tokens activos.
APP_KEY=

# URL pública del backend (usada internamente por AdonisJS para validar URLs).
APP_URL=http://localhost:3333

# ── Sesión ────────────────────────────────────────────────────────────────────
SESSION_DRIVER=cookie

# ── Base de Datos PostgreSQL ──────────────────────────────────────────────────
# IMPORTANTE: los nombres exactos de las variables deben ser DB_HOSTNAME y
# DB_USERNAME (no DB_HOST ni DB_USER). El validador de env.ts rechazará el
# arranque si se usan los nombres incorrectos.
DB_HOSTNAME=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Habilitar SSL en la conexión PostgreSQL (true/false). Dejar vacío o false
# para redes internas sin SSL.
DB_SSL=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dominio del panel administrativo. En desarrollo acepta el puerto de Vite.
# En producción debe coincidir exactamente con el dominio público del admin.
CORS_ORIGIN=http://localhost:5173

# ── Ciudadanía Digital (AGETIC) ───────────────────────────────────────────────
# Credenciales del sistema registrado en el proveedor OAuth2 de AGETIC.
# Entorno de pruebas: https://proveedor.ciudadania.demo.agetic.gob.bo
# Entorno de producción: https://proveedor.ciudadania.gob.bo
AGETIC_CLIENT_ID=
AGETIC_REDIRECT_URI=bo.edu.uto.carnetdigital:/oauth2redirect

# ── Seeder — Configuración inicial ───────────────────────────────────────────
# ID numérico único de este sistema en la tabla public.sistemas.
# Verificar que no colisione con otro sistema de la universidad.
SYSTEM_ID=7

# Credenciales del usuario administrador inicial creado por el seeder.
# Cambiar antes del primer despliegue en producción.
INITIAL_ADMIN_USER=admin.dtic
INITIAL_ADMIN_PASSWORD=admin123
