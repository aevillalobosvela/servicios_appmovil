# ──────────────────────────────────────────────────────────────────────
# Configuración del Despliegue con Docker Compose — Servicios Digitales UTO
# Copiar este archivo como '.env' en la raíz antes de ejecutar docker compose
# ──────────────────────────────────────────────────────────────────────

# Clave de encriptación de AdonisJS
# Generar con: cd backend && node ace generate:key  (ejecutar UNA SOLA VEZ)
# ADVERTENCIA: Cambiar este valor en producción invalida todas las sesiones activas
APP_KEY=tu_app_key_segura_generada_con_ace

# URL pública del backend (usada internamente por AdonisJS para validar URLs)
APP_URL=https://api-servicios.uto.edu.bo

# Configuración de Base de Datos PostgreSQL
DB_HOSTNAME=<IP o hostname del servidor PostgreSQL>
DB_PORT=5432
DB_DATABASE=servicios_uto
DB_USERNAME=uto_admin_db
DB_PASSWORD=contrasena_altamente_segura_para_el_db

# Dirección de origen de CORS (Dominio público del Panel Administrativo)
# Esto indica al backend quién está autorizado a consultarlo vía web
CORS_ORIGIN=https://servicios.uto.edu.bo

# URL pública de la API del backend (Es inyectada durante la compilación de Docker del Admin)
VITE_API_URL=https://api-servicios.uto.edu.bo/api/v1

# Credenciales del usuario administrador inicial (seeder)
# Si se omiten, por defecto el seeder usará: admin.dtic / admin123
INITIAL_ADMIN_USER=admin.dtic
INITIAL_ADMIN_PASSWORD=admin123

# ID del sistema asignado por la DTIC (por defecto: 7)
# Permite evitar colisiones si el ID 7 ya está ocupado en public.sistemas
SYSTEM_ID=7

